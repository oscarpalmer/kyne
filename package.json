{
	"name": "@oscarpalmer/kyne",
	"version": "0.4.0",
	"description": "Something to help find your way?",
	"keywords": [],
	"license": "MIT",
	"author": {
		"name": "Oscar Palmér",
		"url": "https://oscarpalmer.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarpalmer/kyne.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "vpx vp run tsdown:build && vpx vp pack",
		"tsdown:build": "vpx tsdown -c ./tsdown.config.ts",
		"tsdown:watch": "vpx tsdown -c ./tsdown.config.ts --watch",
		"test": "npx vp test run --coverage",
		"test:leak": "vpx vp test run --detect-async-leaks --coverage",
		"www": "concurrently \"php -S localhost:3000\" \"vp run tsdown:watch\""
	},
	"dependencies": {
		"@oscarpalmer/atoms": "^0.226",
		"@oscarpalmer/toretto": "^0.59"
	},
	"devDependencies": {
		"@oscarpalmer/abydon": "^0.25",
		"@oscarpalmer/oui": "^0.44",
		"@types/node": "^26.6",
		"@vitest/coverage-istanbul": "5.1.0",
		"concurrently": "^10",
		"jsdom": "^31",
		"tsdown": "^0.23",
		"typescript": "^7",
		"vite-plus": "^1.7"
	}
}
